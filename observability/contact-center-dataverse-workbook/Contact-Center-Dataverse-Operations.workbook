    {
      "type": 12,
      "name": "page-Overview",
      "conditionalVisibility": {
        "value": "Overview",
        "comparison": "isEqualTo",
        "parameterName": "SelectedPage"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Overview",
        "expandable": false,
        "expanded": true,
        "items": [
          {
            "type": 1,
            "name": "text-f548367f-cbfb-49e3-a3ef-44de52c3febe",
            "content": {
              "json": "## Contact Center and Dataverse operational health\nA single operational view across conversation diagnostics, Dataverse APIs, throttling, dependencies, and failures.\n\n> **Data readiness:** Contact Center events arrive in \traces; Dataverse API calls in \requests; plug-ins and SDK calls in dependencies; failures in \u001bxceptions. Exports can take up to 24 hours to populate."
            }
          },
          {
            "type": 3,
            "name": "query-240fcd67-b383-4534-8d8c-603e1b864f60",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Conversation events",
              "query": "traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| summarize ['Conversation events']=count()",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-3048881f-fb5a-4ec4-93d2-50eca1e3acc3",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Distinct conversations",
              "query": "traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| where isnotempty(ConversationId)\r\n| summarize Conversations=dcount(ConversationId)",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-70da19aa-522e-4c7d-9a06-a8c44576b66c",
            "content": {
              "version": "KqlItem/1.0",
              "title": "HTTP 429 responses",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize ['HTTP 429 responses']=countif(resultCode == \"429\")",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-280c460d-c769-4625-a5fb-6c590405a1b9",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Dataverse failures",
              "query": "union isfuzzy=true\r\n    (requests | where timestamp {TimeRange} | where success == false),\r\n    (dependencies | where timestamp {TimeRange} | where success == false),\r\n    (exceptions | where timestamp {TimeRange})\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize Failures=count()",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-b6b35700-0c1e-4673-972a-17f32e4a129b",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Telemetry arrival by table",
              "query": "union isfuzzy=true withsource=TelemetryTable\r\n    (requests | where timestamp {TimeRange}),\r\n    (dependencies | where timestamp {TimeRange}),\r\n    (pageViews | where timestamp {TimeRange}),\r\n    (traces | where timestamp {TimeRange}),\r\n    (customEvents | where timestamp {TimeRange}),\r\n    (exceptions | where timestamp {TimeRange})\r\n| summarize Records=count(), FirstSeen=min(timestamp), LastSeen=max(timestamp) by TelemetryTable\r\n| order by Records desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "barchart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "50"
          },
          {
            "type": 3,
            "name": "query-ce65479b-6cb9-4a83-8912-ba6647a37179",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Conversation events by channel",
              "query": "traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| summarize Events=count(), Conversations=dcount(ConversationId) by Channel=iff(isempty(Channel), \"(unknown)\", Channel)\r\n| order by Events desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "piechart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "50"
          },
          {
            "type": 3,
            "name": "query-b9db3b1d-24e1-4b30-b9fa-88335b21f279",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Operational anomaly trend",
              "query": "traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| where Subscenario in (\"CSRRejected\",\"CSRNotificationTimeout\",\"ConversationAutoRejected\",\"CustomerDisconnected\",\"Call Ended\",\"TimeoutRuleTriggered\",\"ChatAuthentication\")\r\n    or Description has_any (\"error\",\"fail\",\"timeout\")\r\n| summarize Events=count() by bin(timestamp,{TimeRange:grain}), Subscenario\r\n| order by timestamp asc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "timechart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-6c04d6f4-a474-430b-914e-d7b6653ca08a",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Items requiring attention",
              "query": "traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| extend QueueName=tostring(Result.DisplayName)\r\n| where \"{Queue}\" == \"*\" or QueueName == \"{Queue}\"\r\n| where Subscenario in (\"CSRRejected\",\"CSRNotificationTimeout\",\"ConversationAutoRejected\",\"CustomerDisconnected\",\"Call Ended\",\"TimeoutRuleTriggered\",\"ChatAuthentication\")\r\n    or Description has_any (\"error\",\"fail\",\"timeout\")\r\n| project timestamp, ConversationId, Channel, QueueName, Subscenario, EventType, Description, AgentId, CallId\r\n| order by timestamp desc\r\n| take 200",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          }
        ]
      }
    },
    {
      "type": 12,
      "name": "page-Voice",
      "conditionalVisibility": {
        "value": "Voice",
        "comparison": "isEqualTo",
        "parameterName": "SelectedPage"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Voice",
        "expandable": false,
        "expanded": true,
        "items": [
          {
            "type": 1,
