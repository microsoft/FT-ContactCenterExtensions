          {
            "type": 3,
            "name": "query-1ba44f49-727a-4868-aa7d-a7f821c4795b",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Exception trend",
              "query": "exceptions\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize Exceptions=count() by bin(timestamp,{TimeRange:grain}), problemId\r\n| order by timestamp asc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "timechart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-5d079a4c-b64d-4fd5-a22f-f34eaf52a0da",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Top exceptions",
              "query": "exceptions\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| extend Entity=tostring(cd.entityName), Plugin=tostring(cd.pluginName), Source=tostring(cd.exceptionSource)\r\n| summarize Exceptions=count(), Users=dcount(user_Id), LastSeen=max(timestamp), SampleMessage=take_any(outerMessage) by problemId, type, Entity, Plugin, Source\r\n| top 50 by Exceptions desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "barchart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "50"
          },
          {
            "type": 3,
            "name": "query-da5e2157-81c2-43be-aa2c-538b58db89db",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Plug-in performance",
              "query": "dependencies\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where type==\"Plugin\"\r\n| summarize Executions=count(), Failures=countif(success==false), TotalOccupiedMs=sum(duration), P95Duration=percentile(duration,95), MaxDuration=max(duration) by name, target\r\n| top 50 by TotalOccupiedMs desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "barchart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "50"
          },
          {
            "type": 3,
            "name": "query-b6b1058e-44e4-4846-8124-615c36a7860b",
            "content": {
              "version": "KqlItem/1.0",
              "title": "SDK performance",
              "query": "dependencies\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where type startswith \"SDK\"\r\n| summarize Executions=count(), Failures=countif(success==false), TotalOccupiedMs=sum(duration), P95Duration=percentile(duration,95), MaxDuration=max(duration) by type, name, target\r\n| top 100 by TotalOccupiedMs desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-3c045c34-5cc3-435d-bbe9-05a3f47e31a6",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Form and page-load performance",
              "query": "pageViews\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions), Entity=tostring(customDimensions.entityName), LoadType=tostring(customDimensions.loadType)\r\n| summarize Loads=count(), AvgDuration=avg(duration), P75Duration=percentile(duration,75), P95Duration=percentile(duration,95), MaxDuration=max(duration) by name, Entity, LoadType\r\n| top 100 by P95Duration desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-4ab6a2cd-adda-481e-bb05-4fb4eea3d5a8",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Outbound dependency failures",
              "query": "dependencies\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where type!=\"Plugin\" and not(type startswith \"SDK\")\r\n| where success==false or duration > toreal(\"{SlowThresholdMs}\")\r\n| project timestamp, type, name, target, resultCode, duration, success, operation_Id, operation_ParentId, customDimensions\r\n| order by timestamp desc\r\n| take 500",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
