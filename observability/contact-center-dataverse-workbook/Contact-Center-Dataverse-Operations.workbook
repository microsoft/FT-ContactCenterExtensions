        "items": [
          {
            "type": 1,
            "name": "text-a690b7cb-fb5c-4a29-9719-7287f3645f18",
            "content": {
              "json": "## Failures and performance\nExceptions, failed requests, plug-ins, SDK calls, form loads, and outbound dependencies."
            }
          },
          {
            "type": 3,
            "name": "query-8108ffd2-6fcb-46f7-892a-acfb5b71f869",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Exceptions",
              "query": "exceptions\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize Exceptions=count()",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
