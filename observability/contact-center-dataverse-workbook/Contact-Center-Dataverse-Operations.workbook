    {
      "type": 12,
      "name": "page-Lifecycle",
      "conditionalVisibility": {
        "value": "Lifecycle",
        "comparison": "isEqualTo",
        "parameterName": "SelectedPage"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Conversation Lifecycle",
        "expandable": false,
        "expanded": true,
        "items": [
          {
            "type": 1,
            "name": "text-lifecycle-introduction",
            "content": {
              "json": "## Conversation lifecycle\nSee the customer's journey as one connected flow, from arrival to completion.\n\nEnter a **Conversation or correlation ID** in the global filters. Each stage appears once, even when many diagnostic events contributed to it. The connector shows the elapsed time between stages."
            }
          },
          {
            "type": 3,
            "name": "query-lifecycle-flow",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Customer journey",
              "query": "let events = traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]), Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]), Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)), Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]), Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])), Action=tostring(cd[\"omnichannel.action\"]), Event=tostring(cd[\"omnichannel.event\"]), AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])), Queue=tostring(parse_json(tostring(cd[\"omnichannel.result\"])).DisplayName)\r\n| where isnotempty(\"{InvestigationId}\")\r\n| where ConversationId contains \"{InvestigationId}\" or operation_Id contains \"{InvestigationId}\" or operation_ParentId contains \"{InvestigationId}\" or itemId contains \"{InvestigationId}\"\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| extend StageOrder=case(\r\n    Subscenario in (\"ChatInitialization\",\"ChatSessionInitialization\",\"ConversationStarted\",\"MessageReceived\"), 1,\r\n    Subscenario in (\"RouteToQueue\",\"CSRAvailabilityCheck\") or Action has_any (\"route\",\"queue\",\"fallback\"), 2,\r\n    Subscenario in (\"CSRAccepted\",\"CSRRejected\",\"CSRNotificationTimeout\",\"ConversationAutoRejected\",\"Wait for Agent\"), 3,\r\n    Subscenario in (\"Call Connect\",\"MessageProcessed\",\"MessageSent\"), 4,\r\n    Subscenario has_any (\"Transfer\",\"Consult\") or Subscenario in (\"Transcription\",\"Callback\") or Action has_any (\"transfer\",\"consult\"), 5,\r\n    Subscenario in (\"CustomerDisconnected\",\"Call Ended\",\"ConversationClosed\",\"PostChatSurvey\",\"DownloadTranscripts\",\"EmailTranscripts\") or Description has_any (\"closed\",\"ended\",\"disconnected\"), 6,\r\n    0)\r\n| where StageOrder > 0\r\n| extend StageName=case(StageOrder==1,\"Customer arrived\",StageOrder==2,\"Routed\",StageOrder==3,\"Agent assigned\",StageOrder==4,\"Connected\",StageOrder==5,\"Conversation\",StageOrder==6,\"Completed\",\"Journey\")\r\n| extend StageState=case(Subscenario in (\"CSRRejected\",\"CSRNotificationTimeout\",\"ConversationAutoRejected\") or Description has_any (\"failed\",\"error\",\"timeout\"),\"Needs attention\",StageOrder==6,\"Completed\",\"Progress\")\r\n| extend BusinessDetail=case(StageOrder==1,iff(isempty(Channel),\"Conversation opened\",strcat(\"Arrived via \",Channel)),StageOrder==2,iff(isempty(Queue),\"Sent for routing\",strcat(\"Sent to \",Queue)),StageOrder==3,iff(Subscenario in (\"CSRRejected\",\"CSRNotificationTimeout\",\"ConversationAutoRejected\"),\"Assignment was not accepted\",iff(isempty(AgentId),\"Waiting for an agent\",\"Agent accepted\")),StageOrder==4,iff(Channel has \"voice\",\"Call connected\",\"Customer connected\"),StageOrder==5,iff(Subscenario has_any (\"Transfer\",\"Consult\"),\"Transfer or consultation\",\"Customer and agent engaged\"),StageOrder==6,iff(Description has \"disconnect\",\"Customer disconnected\",\"Conversation completed\"),\"\")\r\n| project timestamp, StageOrder, StageName, StageState, BusinessDetail;\r\nlet stages = events\r\n| summarize FirstSeen=min(timestamp), LastSeen=max(timestamp), Detail=take_anyif(BusinessDetail,isnotempty(BusinessDetail)), State=take_any(StageState), Events=count() by StageOrder, StageName\r\n| order by StageOrder asc\r\n| serialize\r\n| extend PreviousStageOrder=prev(StageOrder), PreviousStageTime=prev(LastSeen)\r\n| extend Timing=strcat(format_datetime(FirstSeen,\"HH:mm:ss\"),\" - \",iff(datetime_diff(\"second\",LastSeen,FirstSeen)==0,\"instant\",strcat(tostring(datetime_diff(\"second\",LastSeen,FirstSeen)),\"s in stage\"))), Gap=iff(isnull(PreviousStageTime),\"\",strcat(tostring(datetime_diff(\"second\",FirstSeen,PreviousStageTime)),\"s\"));\r\nlet nodes = stages\r\n| project Id=strcat(\"stage-\",StageOrder), Name=StageName, Summary=Detail, Timing, Kind=State, Size=1;\r\nlet links = stages\r\n| where isnotnull(PreviousStageOrder)\r\n| project SourceId=strcat(\"stage-\",PreviousStageOrder), TargetId=strcat(\"stage-\",StageOrder), Size=1, Kind=Gap;\r\nnodes | union (links)",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "graph",
              "graphSettings": {
                "type": 0,
                "topContent": {
                  "columnMatch": "Name",
                  "formatter": 1
                },
                "centerContent": {
                  "columnMatch": "Summary",
                  "formatter": 1
                },
                "bottomContent": {
                  "columnMatch": "Timing",
                  "formatter": 1
                },
                "nodeIdField": "Id",
                "sourceIdField": "SourceId",
                "targetIdField": "TargetId",
                "graphOrientation": 3,
                "showOrientationToggles": false,
                "edgeSize": "Size",
                "edgeLabel": "Kind",
                "nodeSize": null,
                "staticNodeSize": 150,
                "colorSettings": {
                  "nodeColorField": "Kind",
                  "type": 1,
                  "colorPalette": "pastel"
                },
                "hivesMargin": 12
              },
              "noDataMessage": "Enter a conversation or correlation ID to draw its customer journey.",
              "showRefreshButton": true,
              "showExportToExcel": false
            }
          }
        ]
      }
    },
    {
      "type": 12,
      "name": "page-Investigator",
      "conditionalVisibility": {
        "value": "Investigator",
        "comparison": "isEqualTo",
        "parameterName": "SelectedPage"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Investigator",
        "expandable": false,
        "expanded": true,
        "items": [
          {
            "type": 1,
            "name": "text-6612ae08-81d7-4039-9728-073aa220e41a",
            "content": {
              "json": "## Conversation and correlation investigator\nEnter a conversation ID, operation ID, parent ID, item ID, or service-request ID in the global filter."
            }
          },
          {
            "type": 3,
            "name": "query-14b218d1-1845-4ff7-ab2e-ba7c13e76011",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Conversation lifecycle",
              "query": "traces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| where isempty(\"{InvestigationId}\")\r\n    or ConversationId contains \"{InvestigationId}\"\r\n    or operation_Id contains \"{InvestigationId}\"\r\n    or operation_ParentId contains \"{InvestigationId}\"\r\n    or itemId contains \"{InvestigationId}\"\r\n| project timestamp, ConversationId, Channel, Subscenario, EventType, Event, Action, Description, AgentId, CallId, operation_Id, operation_ParentId, itemId, customDimensions\r\n| order by timestamp asc\r\n| take 1000",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-c42c9a50-7315-42df-9d9a-75508cc61a40",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Correlated Dataverse telemetry",
              "query": "union isfuzzy=true withsource=TelemetryTable requests, dependencies, exceptions, traces, customEvents, pageViews\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| where isempty(\"{InvestigationId}\")\r\n    or operation_Id contains \"{InvestigationId}\"\r\n    or operation_ParentId contains \"{InvestigationId}\"\r\n    or itemId contains \"{InvestigationId}\"\r\n    or tostring(cd.requestId) contains \"{InvestigationId}\"\r\n    or tostring(cd.serviceRequestId) contains \"{InvestigationId}\"\r\n    or tostring(cd[\"powerplatform.analytics.resource.id\"]) contains \"{InvestigationId}\"\r\n| project timestamp, TelemetryTable, name, operation_Name, operation_Id, operation_ParentId, itemId, success, resultCode, duration, message, outerMessage, type, target, customDimensions\r\n| order by timestamp asc\r\n| take 2000",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-4b1094bc-5d3e-4a61-b35e-e0cf19e1437e",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Raw custom dimensions",
              "query": "union isfuzzy=true withsource=TelemetryTable traces, requests, dependencies, exceptions, customEvents\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| where isempty(\"{InvestigationId}\")\r\n    or operation_Id contains \"{InvestigationId}\"\r\n    or operation_ParentId contains \"{InvestigationId}\"\r\n    or itemId contains \"{InvestigationId}\"\r\n    or tostring(cd[\"powerplatform.analytics.resource.id\"]) contains \"{InvestigationId}\"\r\n| mv-expand Key=bag_keys(cd)\r\n| project timestamp, TelemetryTable, Key=tostring(Key), Value=tostring(cd[tostring(Key)]), operation_Id, operation_ParentId\r\n| order by timestamp asc, Key asc\r\n| take 5000",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          }
        ]
      }
    }
  ],
  "fallbackResourceIds": [],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
