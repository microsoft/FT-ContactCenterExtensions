        "items": [
          {
            "type": 1,
            "name": "text-45d6dd47-7f55-4fec-9eb4-269fba42b05f",
            "content": {
              "json": "## Dataverse APIs and throttling\nHTTP 429 impact, API latency, query throttling, callers, and the successful work that occupied execution time."
            }
          },
          {
            "type": 3,
            "name": "query-d82d8467-4099-4706-8a35-fb2a59e2929c",
            "content": {
              "version": "KqlItem/1.0",
              "title": "API requests",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize ['API requests']=count()",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-a64ecd41-3140-421f-b009-51f87d278679",
            "content": {
              "version": "KqlItem/1.0",
              "title": "HTTP 429",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize ['HTTP 429']=countif(resultCode==\"429\")",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
