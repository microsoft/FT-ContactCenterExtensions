      "content": {
        "json": "# Contact Center and Dataverse Operations\n**Demo-ready observability for voice, messaging, routing, APIs, throttling, failures, and investigation.**"
      }
    },
    {
      "type": 9,
      "name": "parameters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "parameters": [
          {
            "id": "a2eb317e-5056-44b6-8e81-ccd162a8e355",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedPage",
            "type": 1,
            "value": "Overview",
            "isRequired": true,
            "isHiddenWhenLocked": true
          },
          {
            "id": "41d80c29-66e0-4380-80be-040110dbe2f8",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 604800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
