              "query": "let events =\r\ntraces\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend\r\n    Scenario=tostring(cd[\"powerplatform.analytics.scenario\"]),\r\n    Subscenario=tostring(cd[\"powerplatform.analytics.subscenario\"]),\r\n    ConversationId=tostring(cd[\"powerplatform.analytics.resource.id\"]),\r\n    Organization=tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType)),\r\n    EventType=tostring(cd.type),\r\n    Description=coalesce(tostring(cd[\"omnichannel.description\"]), tostring(cd[\"Omnichannel.description\"])),\r\n    Action=tostring(cd[\"omnichannel.action\"]),\r\n    Event=tostring(cd[\"omnichannel.event\"]),\r\n    AgentId=coalesce(tostring(cd[\"omnichannel.target_agent.id\"]), tostring(cd[\"omnichannel.agent.id\"])),\r\n    CallId=tostring(cd[\"omnichannel.call.id\"]),\r\n    CallStatusCode=toint(cd.CallStatusCode),\r\n    AdditionalInfo=todynamic(cd[\"omnichannel.additional_info\"]),\r\n    Result=todynamic(cd[\"omnichannel.result\"])\r\n| where Scenario == \"ConversationDiagnosticsScenario\" or isnotempty(Subscenario)\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where \"{Channel}\" == \"*\" or Channel == \"{Channel}\"\r\n| where Subscenario in (\"RouteToQueue\",\"CSRAccepted\")\r\n| project timestamp, ConversationId, Subscenario;\r\nlet routed=events | where Subscenario==\"RouteToQueue\" | project RouteTime=timestamp, ConversationId;\r\nlet accepted=events | where Subscenario==\"CSRAccepted\" | project AcceptTime=timestamp, ConversationId;\r\nrouted\r\n| join kind=inner accepted on ConversationId\r\n| where RouteTime <= AcceptTime\r\n| summarize RouteTime=max(RouteTime) by ConversationId, AcceptTime\r\n| extend AssignmentSeconds=datetime_diff(\"second\",AcceptTime,RouteTime)\r\n| summarize P50=percentile(AssignmentSeconds,50), P95=percentile(AssignmentSeconds,95), Conversations=count() by bin(AcceptTime,{TimeRange:grain})\r\n| order by AcceptTime asc",
