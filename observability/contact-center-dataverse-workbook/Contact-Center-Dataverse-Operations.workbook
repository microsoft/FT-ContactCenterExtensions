          {
            "type": 3,
            "name": "query-a138ffc8-5cfc-4132-ae40-8047c1f56883",
            "content": {
              "version": "KqlItem/1.0",
              "title": "API failures",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize ['API failures']=countif(success==false)",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-c64f2da1-c4c1-455d-9b12-7b22931edeef",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Slow requests",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize ['Slow requests']=countif(duration > toreal(\"{SlowThresholdMs}\"))",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "tiles",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "20"
          },
          {
            "type": 3,
            "name": "query-fa8eab3a-61c5-41e5-a0dc-d23321c6f215",
            "content": {
              "version": "KqlItem/1.0",
              "title": "429 and latency trend",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize Requests=count(), Throttled=countif(resultCode==\"429\"), P95Duration=percentile(duration,95) by bin(timestamp,{TimeRange:grain})\r\n| order by timestamp asc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "timechart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-cd4d0435-9ffe-4ed8-b23d-f6bfdb7dbe2d",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Top throttled operations",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where resultCode==\"429\"\r\n| summarize Responses=count(), Users=dcount(user_Id), P95Duration=percentile(duration,95) by operation_Name\r\n| top 30 by Responses desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "barchart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "50"
          },
          {
            "type": 3,
            "name": "query-36a2059c-7a9c-415b-a488-6e87d9d3f603",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Query-throttling reasons",
              "query": "union isfuzzy=true\r\n    (traces | where timestamp {TimeRange}),\r\n    (customEvents | where timestamp {TimeRange})\r\n| extend cd=todynamic(customDimensions)\r\n| where name =~ \"QueryThrottled\"\r\n    or tostring(cd.throttlingAction) in~ (\"Throttle\", \"Delay\", \"Fail\")\r\n    or isnotempty(tostring(cd.CdsQueryHash))\r\n| extend\r\n    QueryHash=coalesce(tostring(cd.CdsQueryHash), tostring(cd.cdsQueryHash)),\r\n    ThrottleAction=coalesce(tostring(cd.throttlingAction), tostring(cd.ThrottleAction)),\r\n    ThrottleReason=coalesce(tostring(cd.throttleReason), tostring(cd.ThrottleReason)),\r\n    DelayMs=tolong(coalesce(tostring(cd.throttlingDelayMilliseconds), tostring(cd.delayMs))),\r\n    Probability=coalesce(todouble(cd.throttleProbabilityPercentage), todouble(cd.probability)),\r\n    ExpiryTime=todatetime(cd.throttleExpiryTime),\r\n    Command=coalesce(tostring(cd.Command), tostring(cd.command)),\r\n    Organization=coalesce(tostring(cd.environmentId), tostring(cd.EnvironmentId), tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize Events=count(), AvgDelayMs=avg(DelayMs) by Reason=iff(isempty(ThrottleReason),\"(unspecified)\",ThrottleReason)\r\n| top 20 by Events desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "piechart",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            },
            "customWidth": "50"
          },
          {
            "type": 3,
            "name": "query-ff2a0cf2-afdd-4b3f-bc67-70167aff9eca",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Top query hashes and delay",
              "query": "union isfuzzy=true\r\n    (traces | where timestamp {TimeRange}),\r\n    (customEvents | where timestamp {TimeRange})\r\n| extend cd=todynamic(customDimensions)\r\n| where name =~ \"QueryThrottled\"\r\n    or tostring(cd.throttlingAction) in~ (\"Throttle\", \"Delay\", \"Fail\")\r\n    or isnotempty(tostring(cd.CdsQueryHash))\r\n| extend\r\n    QueryHash=coalesce(tostring(cd.CdsQueryHash), tostring(cd.cdsQueryHash)),\r\n    ThrottleAction=coalesce(tostring(cd.throttlingAction), tostring(cd.ThrottleAction)),\r\n    ThrottleReason=coalesce(tostring(cd.throttleReason), tostring(cd.ThrottleReason)),\r\n    DelayMs=tolong(coalesce(tostring(cd.throttlingDelayMilliseconds), tostring(cd.delayMs))),\r\n    Probability=coalesce(todouble(cd.throttleProbabilityPercentage), todouble(cd.probability)),\r\n    ExpiryTime=todatetime(cd.throttleExpiryTime),\r\n    Command=coalesce(tostring(cd.Command), tostring(cd.command)),\r\n    Organization=coalesce(tostring(cd.environmentId), tostring(cd.EnvironmentId), tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize Events=count(), AvgDelayMs=round(avg(DelayMs),1), P95DelayMs=percentile(DelayMs,95), MaxDelayMs=max(DelayMs), SampleCommand=take_any(substring(Command,0,500)) by QueryHash, ThrottleAction, ThrottleReason\r\n| top 100 by Events desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-52a9a8ef-061e-4550-865a-7b7617ca5ac4",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Successful callers by occupied execution time",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where resultCode startswith \"2\"\r\n| extend AppId=coalesce(tostring(cd.appId),tostring(cd.applicationId),tostring(cd.aadAppId))\r\n| summarize Successful=count(), TotalOccupiedMs=sum(duration), AvgDuration=avg(duration), P95Duration=percentile(duration,95), MaxDuration=max(duration) by user_Id, AppId, operation_Name\r\n| top 100 by TotalOccupiedMs desc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          },
          {
            "type": 3,
            "name": "query-4a6df806-dc40-4722-9720-8e8a8f1d78de",
            "content": {
              "version": "KqlItem/1.0",
              "title": "Recent throttling details",
              "query": "requests\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| where resultCode==\"429\"\r\n| project timestamp, operation_Name, name, duration, user_Id, session_Id, operation_Id, operation_ParentId, url, customDimensions\r\n| order by timestamp desc\r\n| take 500",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.insights/components",
              "crossComponentResources": [
                "{ApplicationInsightsResource}"
              ],
              "timeContextFromParameter": "TimeRange",
              "visualization": "table",
              "noDataMessage": "No matching telemetry has arrived for this selection.",
              "showRefreshButton": true,
              "showExportToExcel": true
            }
          }
        ]
      }
