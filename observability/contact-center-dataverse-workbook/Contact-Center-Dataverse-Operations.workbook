              "query": "dependencies\r\n| where timestamp {TimeRange}\r\n| extend cd=todynamic(customDimensions)\r\n| extend Organization=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where \"{Organization}\" == \"*\" or Organization == \"{Organization}\"\r\n| summarize ['Failed SDK calls']=countif(type startswith \"SDK\" and success==false)",
              "size": 0,
