                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "08e9b241-8bf5-44b0-955e-69c2c04e4e21",
            "version": "KqlParameterItem/1.0",
            "name": "ApplicationInsightsResource",
            "label": "Application Insights resource",
            "type": 5,
            "isRequired": true,
            "query": "where type == 'microsoft.insights/components' | project value=id, label=name, group=resourceGroup",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "value": "",
            "typeSettings": {
              "showDefault": false,
              "resourceTypeFilter": {
                "microsoft.insights/components": true
              },
              "additionalResourceOptions": []
            }
          },
          {
            "id": "b93fb934-1233-43aa-8c6d-3bfcc20a1d30",
            "version": "KqlParameterItem/1.0",
            "name": "Organization",
            "label": "Organization / environment",
            "type": 2,
            "isRequired": false,
            "query": "union isfuzzy=true\r\n    (traces | extend cd=todynamic(customDimensions)),\r\n    (requests | extend cd=todynamic(customDimensions)),\r\n    (dependencies | extend cd=todynamic(customDimensions))\r\n| extend Org=coalesce(\r\n    tostring(cd[\"powerplatform.analytics.resource.organization.id\"]),\r\n    tostring(cd.environmentId),\r\n    tostring(cd.EnvironmentId),\r\n    tostring(cd.organizationUrl))\r\n| where isnotempty(Org)\r\n| distinct value=Org, label=Org\r\n| order by label asc",
            "queryType": 0,
            "resourceType": "microsoft.insights/components",
            "crossComponentResources": [
              "{ApplicationInsightsResource}"
            ],
            "timeContextFromParameter": "TimeRange",
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "showDefault": false,
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            }
          },
          {
            "id": "9fedd66a-2306-4d32-b8a0-a2e29ae0e51b",
            "version": "KqlParameterItem/1.0",
            "name": "Channel",
            "label": "Channel",
            "type": 2,
            "isRequired": false,
            "query": "traces\r\n| extend cd=todynamic(customDimensions)\r\n| extend Channel=coalesce(tostring(cd[\"omnichannel.channel.type\"]), tostring(cd.ChannelType), tostring(cd.channelType))\r\n| where isnotempty(Channel)\r\n| distinct value=Channel, label=Channel\r\n| order by label asc",
            "queryType": 0,
            "resourceType": "microsoft.insights/components",
            "crossComponentResources": [
              "{ApplicationInsightsResource}"
            ],
            "timeContextFromParameter": "TimeRange",
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "showDefault": false,
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            }
          },
          {
            "id": "6d30e112-eb72-4603-abfd-79fd27926d65",
            "version": "KqlParameterItem/1.0",
            "name": "Queue",
            "label": "Queue",
            "type": 2,
            "isRequired": false,
            "query": "traces\r\n| extend cd=todynamic(customDimensions)\r\n| where tostring(cd[\"powerplatform.analytics.subscenario\"]) == \"RouteToQueue\"\r\n| extend QueueName=tostring(parse_json(tostring(cd[\"omnichannel.result\"])).DisplayName)\r\n| where isnotempty(QueueName)\r\n| distinct value=QueueName, label=QueueName\r\n| order by label asc",
            "queryType": 0,
            "resourceType": "microsoft.insights/components",
            "crossComponentResources": [
              "{ApplicationInsightsResource}"
            ],
            "timeContextFromParameter": "TimeRange",
            "defaultValue": "value::all",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "showDefault": false,
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            }
          },
          {
            "id": "82f1900a-3637-4ef9-b2a1-a6153f393622",
            "version": "KqlParameterItem/1.0",
            "name": "InvestigationId",
            "label": "Conversation or correlation ID",
            "type": 1,
            "isRequired": false,
            "value": ""
          },
          {
            "id": "0ebb74d1-4543-46a6-9e87-8a13ed0fba40",
            "version": "KqlParameterItem/1.0",
            "name": "SlowThresholdMs",
            "label": "Slow threshold (ms)",
            "type": 1,
            "isRequired": true,
            "value": "5000"
          }
        ]
      }
    },
